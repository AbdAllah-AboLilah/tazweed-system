rules_version = '2';

// قواعد أمان Firestore — طبقًا لملف المواصفات (قسم 4: الأدوار والصلاحيات)
// المرحلة 3: نظام النواقص — إضافة انتقالات حالة status محدّدة لأمين الفرع
// (طلب/إلغاء تزويد) وأمين الرئيسي (تزويد/تصفير/إرجاع)، فوق تعديل الكميات.
// + إضافة أحدث: طلبات الطباعة عن بُعد (printJobs) لإرسال طباعة لمكان تاني.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userProfile().role;
    }

    // ============================================================
    // ⭐ نظام المفاتيح — نفس اللي في js/permissions.js بالظبط
    // ============================================================
    // القاعدة اللي بيمشي عليها كل شيء تحت:
    //
    //   1) لو الحساب فيه استثناء متسجّل على المفتاح ده → ياخد بيه
    //   2) وإلا → قالب رتبته
    //   3) وإلا → مقفول
    //
    // ⚠️ ليه ده مكتوب هنا كمان مع إنه مكتوب في الواجهة؟ لأن إخفاء الزرار
    // من الشاشة **مش حماية**. أي حد فاهم يقدر يبعت الطلب مباشرة للسحابة
    // من غير ما يفتح الشاشة أصلًا. الواجهة بتمنع الغلط، والقواعد دي هي
    // اللي بتمنع الاختراق.
    //
    // ⚠️ وأي مفتاح جديد يتضاف في permissions.js **لازم** يتضاف هنا كمان،
    // وإلا هيبقى مجرد ديكور.


    // قوالب الرتب — لازم تفضل مطابقة لـ ROLE_PRESETS في permissions.js
    function presetHas(key) {
      return (role() in ['owner', 'admin'])
        || (role() == 'branch_manager' && key != 'manageUsers')
        || (role() == 'supervisor' && key in ['manageCategories', 'addGrades', 'printLabel', 'printRestock', 'printScreen', 'remotePrint', 'viewProducts', 'excelTools', 'viewActivity'])
        || (role() == 'warehouse_keeper' && key in ['editBranchQty', 'editMainQty', 'addGrades', 'printLabel', 'printRestock', 'printScreen', 'viewProducts', 'viewActivity'])
        || (role() == 'print_operator' && key in ['printLabel', 'printScreen', 'remotePrint'])
        || (role() == 'user' && key in ['printLabel', 'printScreen', 'viewProducts', 'viewActivity']);
    }

    // ⚠️ الشكل ده بالذات (مسار متداخل في get واحدة) مقصود:
    // الشكل التاني — userProfile().get('perms', {}).get(key, ...) — بيرمي
    // "evaluation error" في Firestore لما الحساب مالوش حقل perms أصلًا،
    // وده حال كل الحسابات القديمة. أمسكناها بالمحاكي قبل ما توصل للمحل.
    function can(key) {
      return isSignedIn() && userProfile().get(['perms', key], presetHas(key)) == true;
    }

    // منشئ النظام — بيتربط بمعرّف الحساب تحت (OWNER_UID) عشان محدش يقدر
    // ينزّل رتبته من جوه النظام.
    function isOwnerRole() {
      return isSignedIn() && role() in ['owner', 'admin'];
    }

    // معرّف حساب صاحب المحل. الحساب ده مايتعدّلش ولا يتحذف من أي حد
    // تاني — ولا حتى من حساب معاه مفتاح "إدارة الحسابات".
    //
    // ⚠️ الرقم ده مكتوب هنا **عن قصد** مش متخزّن في قاعدة البيانات:
    // لو كان متخزّن فيها، أي حد معاه صلاحية على الحسابات كان هيقدر يغيّره
    // ويلغي الحماية. تغييره محتاج تعديل الملف ده ورفعه — وده محتاج صلاحية
    // على المستودع نفسه.
    function ownerUid() {
      return 'Pj08zlRJTKdULRgFfKHB36xAsRw1';
    }

    function isTheOwner() {
      return isSignedIn() && request.auth.uid == ownerUid();
    }

    function isAdmin() {
      return can('manageUsers');
    }

    function warehouseAccess() {
      return userProfile().get('warehouseAccess', 'both');
    }

    // مفتاح "يقدر" + خانة "أنهي مخزن" — الاتنين لازم يوافقوا.
    function isBranchKeeper() {
      return can('editBranchQty') && (warehouseAccess() in ['branch', 'both'] || warehouseAccess() == null);
    }

    function isMainKeeper() {
      return can('editMainQty') && (warehouseAccess() in ['main', 'both'] || warehouseAccess() == null);
    }

    function onlyChangedKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function oldStatus() { return resource.data.status; }
    function newStatus() { return request.resource.data.status; }

    // القاعدة الجوهرية في المنطق الجديد: **الكمية هي اللي تحدد الحالة**.
    //   فيه كمية في الفرع            → عادي
    //   الفرع صفر والرئيسي فيه كمية  → معلّق
    //   الفرع صفر والرئيسي صفر       → خلصت
    // الدالة دي بتتأكد إن الحالة الجديدة مطابقة للكميات الجديدة فعلًا،
    // فمحدش يقدر يعلن حالة تخالف الأرقام المسجّلة.
    function statusMatchesQty(branch, main, s) {
      return (branch > 0 && s == 'normal')
        || (branch == 0 && main > 0 && s == 'pending')
        || (branch == 0 && main == 0 && s == 'out');
    }

    function newBranchQty() { return request.resource.data.branchQty; }
    function newMainQty() { return request.resource.data.mainQty; }

    function branchAction() {
      return isBranchKeeper() && (
        onlyChangedKeys(['branchQty'])
        || (onlyChangedKeys(['status']) && oldStatus() == 'normal' && newStatus() == 'pending')
        || (onlyChangedKeys(['status']) && oldStatus() == 'pending' && newStatus() == 'normal')
        // التغيير التلقائي: الكمية والحالة بيتغيّروا مع بعض في كتابة واحدة،
        // بشرط إن الحالة الجديدة مطابقة للأرقام.
        || (
          onlyChangedKeys(['branchQty', 'status'])
          && statusMatchesQty(newBranchQty(), resource.data.get('mainQty', 0), newStatus())
        )
      );
    }

    // أمين المخزن الرئيسي: يعدّل mainQty، أو يرد على طلب معلّق (تزويد فعلي
    // بنقل كمية، أو تصفير كامل لو مفيش عنده حاجة)، أو يرجّع درجة خلصت لتبقى متاحة.
    function mainAction() {
      return isMainKeeper() && (
        onlyChangedKeys(['mainQty'])
        || (onlyChangedKeys(['status', 'mainQty', 'branchQty']) && oldStatus() == 'pending' && newStatus() == 'normal')
        || (onlyChangedKeys(['status']) && oldStatus() == 'pending' && newStatus() == 'out')
        || (onlyChangedKeys(['status']) && oldStatus() == 'out' && newStatus() == 'normal')
        // التغيير التلقائي من ناحية الرئيسي: نزّل الكمية لصفر فالدرجة
        // بتتحول "خلصت"، أو دخّل كمية وهي "خلصت" فبترجع "معلّقة".
        || (
          onlyChangedKeys(['mainQty', 'status'])
          && statusMatchesQty(resource.data.get('branchQty', 0), newMainQty(), newStatus())
        )
      );
    }

    // ⚠️ نقطة دقيقة اتفصلت هنا عن قصد:
    //
    // اللي بيدير الفئات بيحتاج يعدّل حقول **الكتالوج** في الدرجة (مجموعة
    // اللون، اسم الدرجة الأساسية، حدها الحرج) — لكن ده **مش** معناه إنه
    // يقدر يلمس الكميات. رتبة "المشرف" بالظبط كده: بينظّم الشيت ومايعدّلش
    // في الأرقام.
    //
    // فالكتالوج ليه مساره، والكميات ليها مسارها، وكل واحد بمفتاحه.
    function catalogGradeEdit() {
      return can('manageCategories')
        && onlyChangedKeys(['group', 'name', 'criticalQty', 'number', 'isBase']);
    }

    function canUpdateGrade() {
      return catalogGradeEdit() || branchAction() || mainAction();
    }

    // حسابات المستخدمين: القراءة لأي مستخدم مسجّل دخول (عشان نعرض الاسم/الدور)،
    // والكتابة (إنشاء/تعديل/حذف حسابات) للمدير فقط.
    match /users/{userId} {
      allow read: if isSignedIn();

      // ⚠️ حماية منشئ النظام: حسابه مايتعدّلش ولا يتحذف من أي حد تاني.
      // من غير السطر ده، أي حساب معاه مفتاح "إدارة الحسابات" كان يقدر
      // ينزّل رتبة صاحب المحل ويقفل عليه نظامه — ومفيش طريقة يرجّعها من
      // جوه النظام.
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && (userId != ownerUid() || isTheOwner());

      // استثناء ضيّق: أي مستخدم يقدر يحدّث **حقل lastSeen بتاعه هو بس**
      // (بيتحدّث كل 5 دقايق) عشان لوحة التحكم توري مين شغّال دلوقتي.
      // مايقدرش يغيّر رتبته ولا صلاحياته ولا يلمس حساب حد تاني — القاعدة
      // بترفض أي تعديل بيمس أي حقل غير lastSeen.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && onlyChangedKeys(['lastSeen']);
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if can('manageCategories');
      allow delete: if can('deleteCategories');

      match /grades/{gradeId} {
        allow read: if isSignedIn();
        allow create: if can('addGrades');
        allow delete: if can('deleteGrades');
        allow update: if canUpdateGrade();
      }
    }

    // ⚠️ لازم تفضل موجودة: عدّاد "الطلبات المعلّقة" (الـBadge البنفسجي)
    // بيستخدم استعلام من نوع collectionGroup على كل الدرجات في كل الفئات
    // مرة واحدة. Firestore بيرفض النوع ده من الاستعلام لو القاعدة الوحيدة
    // الموجودة هي القاعدة المتداخلة فوق — لازم قاعدة بالمسار الشامل
    // ({path=**}) زي دي بالتحديد. من غيرها بيظهر الخطأ:
    //   Missing or insufficient permissions
    // قراءة فقط — كل عمليات الكتابة لسه بتمر على القاعدة المتداخلة فوق.
    match /{path=**}/grades/{gradeId} {
      allow read: if isSignedIn();
    }

    // سجل العمليات: أي مستخدم مسجّل دخول يقدر يضيف سجل (وقت تعديله هو نفسه)
    // ويقرأ السجل، لكن محدش يقدر يعدّل أو يمسح سجل قديم — عشان يفضل موثوق.
    match /activityLog/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // طلبات الطباعة عن بُعد: الإنشاء بس لمستخدمين معينين (canSendRemotePrint)
    // أو أصحاب الصلاحية الكاملة. أي مستخدم مسجّل دخول يقدر "يستلم" الطلب
    // ويعلّمه كـ printed (الجهاز المستقبِل)، لكن مش يغيّر حاجة تانية غير كده.
    function canSendPrintJob() {
      return can('remotePrint');
    }

    match /printJobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && canSendPrintJob() && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if isSignedIn()
        && onlyChangedKeys(['status', 'printedByUid', 'printedByName', 'printedAt', 'error'])
        && oldStatus() == 'pending' && newStatus() in ['printed', 'failed'];
      allow delete: if can('manageCategories');
    }

    // قاعدة بيانات الأصناف: محفوظة على شكل "قطع" (كل قطعة مستند فيه آلاف
    // الأصناف) عشان استيراد 50 ألف صنف يبقى 25 كتابة بدل 50 ألف — وده
    // اللي بيخلّيه يدخل في الباقة المجانية.
    // القراءة لأي حد داخل النظام (كل الشاشات محتاجاها)، والكتابة لصاحب
    // الصلاحية الكاملة بس.
    match /products/{docId} {
      allow read: if isSignedIn();
      allow write: if can('importProducts');
    }

    // نقاط الطباعة: كل جهاز عليه QZ Tray وطابعة محفوظة بيسجّل نفسه هنا
    // وبيحدّث lastSeen كل شوية (نبضة). ده اللي بيخلي اللي بيطبع عن بُعد
    // يشوف الأجهزة المتصلة **دلوقتي** بالاسم، ويبعت لجهاز محدد بدل
    // "الفرع/الرئيسي" (الطابعات كلها في مكتب الكاشير في الفرع أصلًا).
    // أي مستخدم مسجّل دخول يقدر يسجّل جهازه هو ويحدّثه، ويقرأ القايمة.
    match /printStations/{deviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if can('manageCategories');
    }
  }
}
